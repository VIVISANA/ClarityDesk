# Exact browser origins allowed to send credentialed API requests.
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Host port for the single-origin Docker deployment.
CLARITYDESK_PORT=8080

# Ollama URL used by the backend. Native development uses localhost; Docker
# uses host.docker.internal to reach Ollama running on the Windows host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI_PROVIDER=ollama keeps local Ollama as the default. Set gemini only with
# a Google AI Studio API key; never commit GEMINI_API_KEY.
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
